<?xml version="1.0" encoding="utf-8"?>
<!-- Reference copy of the SignPath artifact configuration "app".
     Paste it into the SignPath project; SignPath uses its own stored copy.
     Signs only MISO's own executable, uploaded alone by .github/workflows/release.yml.
     Electron writes ProductVersion as x.y.z.0 and FileVersion as x.y.z. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="MISO.exe" product-name="MISO" product-version="${version}.0" file-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
