{
  "name": "miso-desktop",
  "version": "1.0.1",
  "private": true,
  "description": "MISO - Your Little Butler",
  "author": "MISO",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "pack": "npm run build:release && node scripts/audit-release.mjs && electron-builder --dir",
    "dist": "npm run build:release && node scripts/audit-release.mjs && electron-builder --publish=never && node scripts/audit-release.mjs --packaged",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:packaged": "node scripts/audit-release.mjs --packaged && node scripts/verify-packaged.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"src/renderer/*.css\" \"tests/**/*.ts\" \"scripts/*.mjs\" package.json tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/renderer/*.css\" \"tests/**/*.ts\" \"scripts/*.mjs\" package.json tsconfig.json",
    "build:release": "node scripts/build.mjs --release",
    "verify:release": "node scripts/audit-release.mjs --packaged"
  },
  "dependencies": {
    "@googleapis/calendar": "^20.1.0",
    "electron-store": "^11.0.2",
    "google-auth-library": "^11.2.0",
    "luxon": "^3.7.0",
    "rrule": "^2.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.0",
    "@types/node": "^22.0.0",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "3.9.9",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "dev.butler.desktop",
    "productName": "MISO",
    "asar": true,
    "files": [
      "dist/main/*.cjs",
      "dist/renderer/*.js",
      "dist/renderer/*.html",
      "dist/renderer/*.css",
      "dist/assets/*.svg",
      "dist/assets/*.png",
      "dist/assets/*.ico",
      "dist/assets/skins.json",
      "dist/assets/oauth-client.json",
      "package.json",
      "dist/assets/branding/**/*",
      "dist/assets/mascot/**/*",
      "dist/assets/manifest.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "src/assets/branding/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "src/assets/branding/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "src/assets/branding/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "include": "scripts/installer.nsh"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/itsmeabirmohanta/miso.git"
  },
  "homepage": "https://github.com/itsmeabirmohanta/miso#readme",
  "bugs": {
    "url": "https://github.com/itsmeabirmohanta/miso/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
