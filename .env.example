# Reference only: scripts do not automatically load this file.
# Set environment variables in your shell. Never commit real credentials.
# Optional configuration for local development:
BUTLER_GOOGLE_CLIENT_ID=
BUTLER_GOOGLE_CLIENT_SECRET=
# Optional separate public Desktop OAuth configuration for release builds:
# Embedded Desktop OAuth configuration is extractable from the installer.
# Never use your confidential server credentials or personal account tokens.
BUTLER_PUBLIC_GOOGLE_CLIENT_ID=
BUTLER_PUBLIC_GOOGLE_CLIENT_SECRET=
# Optional semicolon-separated private strings for release exclusion checks:
MISO_PRIVATE_RELEASE_MARKERS=
